# Stack de observabilidade (task 0007) — copie para .env.observability (gitignored).
# Nunca versionar valores reais. Credenciais aqui são de leitura mínima.

# Grafana: admin só via env (sem senha literal em YAML versionado).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=troque-esta-senha

# Alertas → Discord (webhook do canal). NÃO deixe vazio: o contact point exige
# URL válida no boot. Em dev use o placeholder abaixo — alertas avaliam e o
# envio falha em log, sem bloquear nada.
DISCORD_WEBHOOK_URL=http://127.0.0.1:9/sem-webhook-configurado

# Watchdog (task 0041): URL de ping do healthchecks.io (check com período 5 min
# e graça ~10 min). É segredo — quem a conhece forja o heartbeat. Sem conta,
# mantenha o placeholder: o ping falha em log, sem efeito.
HEALTHCHECKS_PING_URL=http://127.0.0.1:9/sem-heartbeat-configurado

# postgres-exporter com o usuário pg_monitor criado pelo init do PG.
DATA_SOURCE_URI=postgres:5432/morfeu?sslmode=disable
DATA_SOURCE_USER=morfeu_monitor
DATA_SOURCE_PASS=troque-esta-senha

# redis_exporter (Redis local sem senha; na VM usar REDIS_PASSWORD).
REDIS_ADDR=redis://redis:6379
