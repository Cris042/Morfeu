# Morfeu — modelo do .env (copie para .env e preencha; .env é gitignored)

# Context7 (MCP de documentação — roles.md §6.12)
# Obtenha a chave em https://context7.com/dashboard
# Após preencher, replique em .claude/settings.local.json (env) para a sessão
# do Claude Code — ver lib.md, seção Ferramentas de desenvolvimento.
CONTEXT7_API_KEY=

# Obsidian — segundo cérebro (roles.md §6.13)
# Caminho do vault nesta máquina (fonte efetiva: env do ~/.claude/settings.json)
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SESSION_SUMMARY_ENABLED=1

# Aplicação Morfeu
DATABASE_URL=postgres://postgres:postgres@localhost:5432/morfeu
REDIS_URL=redis://localhost:6379/0
# RabbitMQ (PRD 0002) — credenciais via .env.docker-compose no compose local;
# nunca guest/guest (RNF01)
RABBITMQ_URL=amqp://morfeu:morfeu@localhost:5672/
LOG_LEVEL=info
APP_PORT=8080
CACHE_TTL_SECONDS=300
# Autenticação (task 0009). Gere com: openssl rand -hex 32 — nunca versione.
JWT_SEGREDO=
JWT_KID=k1
# Argon2id (mínimo OWASP; recalibrar na VM) e vagas simultâneas de hashing.
ARGON2_MEMORIA_KIB=19456
ARGON2_ITERACOES=2
ARGON2_PARALELISMO=1
# HASH_CONCORRENCIA=  (padrão: nº de CPUs)
# TMDB (task 0012): token de leitura v4 (bearer) — opcional; sem ele a
# importação fica desativada (503) e o cadastro manual segue normal.
TMDB_API_TOKEN=
# Pagamento (task 0024, ADR 0010). AMBIENTE=producao recusa o gateway fake.
AMBIENTE=dev
# fake (padrão: dev/CI/load-test) ou stripe (modo de teste).
MORFEU_GATEWAY=fake
# Chave RESTRITA de teste (rk_test_…, só PaymentIntents) — chave live é recusada no boot.
STRIPE_SECRET_KEY=
# Segredo do webhook: `stripe listen --print-secret` (perfil "stripe" do compose).
# Sem ele a rota /webhooks/stripe fica desligada.
STRIPE_WEBHOOK_SECRET=
# E-mail do ingresso (tasks 0028–0029). Segredo do token do QR (≥ 32 bytes):
# openssl rand -base64 32 — fixe no dev (sem ele, um aleatório por processo).
INGRESSO_TOKEN_SEGREDO_V1=
BASE_URL_PUBLICA=http://localhost:5173
# fake (padrão: nenhum e-mail sai) ou resend. Sem domínio verificado o Resend só
# entrega ao e-mail do dono da conta (decisão do refinamento E7).
EMAIL_PROVEDOR=fake
RESEND_API_KEY=
EMAIL_REMETENTE=Morfeu <onboarding@resend.dev>
