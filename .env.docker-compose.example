# Docker Compose environment example
# Copy to .env.docker-compose and adjust as needed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ (PRD 0002, RNF01 — nunca guest/guest)
RABBITMQ_DEFAULT_USER=morfeu
RABBITMQ_DEFAULT_PASS=morfeu

# Usuário de monitoração do PG (task 0007) — criado pelo init em volume novo;
# o mesmo valor vai em DATA_SOURCE_PASS do .env.observability.
PG_MONITOR_PASSWORD=troque-esta-senha

# Roles de menor privilégio (task 0042, ADR 0013) — OPCIONAIS em dev: o init
# (configs/postgres/02-roles.sh) só cria o role cuja senha estiver definida, em
# volume novo. Em dev o usuário único (DATABASE_URL) segue valendo; para
# exercitar os roles, defina as senhas e as URLs abaixo. Produção usa
# .env.prod.example.
# PG_MIGRATOR_PASSWORD=troque-esta-senha
# PG_APP_PASSWORD=troque-esta-senha
# PG_PURGE_PASSWORD=troque-esta-senha
# PG_BACKUP_PASSWORD=troque-esta-senha

# App dentro do compose (profile "app", task 0007) — hostnames da rede interna.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/morfeu?sslmode=disable
# Aceita redis://[:senha@]host:porta/db ou host:porta (dev sem senha). Em
# AMBIENTE=producao a senha é obrigatória.
REDIS_URL=redis://redis:6379/0
# Migrations e purga da trilha com roles próprios (ausentes = DATABASE_URL):
# DATABASE_MIGRATE_URL=postgres://morfeu_migrator:SENHA@postgres:5432/morfeu?sslmode=disable
# DATABASE_PURGE_URL=postgres://morfeu_purge:SENHA@postgres:5432/morfeu?sslmode=disable
RABBITMQ_URL=amqp://morfeu:morfeu@rabbitmq:5672/
LOG_LEVEL=info
APP_PORT=8080
# Autenticação do app no compose (task 0009): openssl rand -hex 32
JWT_SEGREDO=troque-por-32-bytes-aleatorios-em-hex
# TMDB (task 0012) — opcional; token v4 de leitura
TMDB_API_TOKEN=
