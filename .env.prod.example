# Produção (task 0042) — copie para .env.prod (gitignored, permissão 600).
# Gere cada senha com `openssl rand -hex 24` (mín. 24 caracteres) e rode
# `make preflight` antes do `up`: ele recusa vazio, placeholder e senha curta.
# Nunca versionar valores reais.

# Superusuário de bootstrap do PG (não é usado pelo app).
POSTGRES_USER=troque-o-usuario-admin
POSTGRES_PASSWORD=troque-esta-senha

# Roles de menor privilégio (ADR 0013): criados pelo init só em volume novo.
PG_MIGRATOR_PASSWORD=troque-esta-senha
PG_APP_PASSWORD=troque-esta-senha
PG_PURGE_PASSWORD=troque-esta-senha
PG_BACKUP_PASSWORD=troque-esta-senha
# Mesmo valor de DATA_SOURCE_PASS no .env.observability.
PG_MONITOR_PASSWORD=troque-esta-senha

# Redis (requirepass). O app usa REDIS_URL=redis://:SENHA@redis:6379/0.
REDIS_PASSWORD=troque-esta-senha

# RabbitMQ (nunca guest/guest).
RABBITMQ_DEFAULT_USER=troque-o-usuario-mq
RABBITMQ_DEFAULT_PASS=troque-esta-senha

# Backup (task 0043, ADR 0013). SÓ a chave pública do age (age1…): a privada
# fica no gerenciador de senhas + cópia offline, NUNCA em .env (o preflight
# recusa AGE-SECRET-KEY). Gere com `age-keygen` em máquina do dono (docs/backup.md).
BACKUP_AGE_RECIPIENT=age1troque-pela-chave-publica
BACKUP_S3_ENDPOINT=https://troque-namespace.compat.objectstorage.troque-regiao.oraclecloud.com
BACKUP_S3_REGION=troque-regiao
BACKUP_S3_BUCKET=troque-bucket
BACKUP_S3_ACCESS_KEY_ID=troque-esta-chave
BACKUP_S3_SECRET_ACCESS_KEY=troque-este-segredo
# Opcional (healthchecks.io; vazio = sem ping). Quando presente, precisa ser https.
BACKUP_HEARTBEAT_URL=
