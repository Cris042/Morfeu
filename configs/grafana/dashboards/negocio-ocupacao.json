{
  "uid": "morfeu-negocio-ocupacao",
  "title": "Negócio — reservas e ocupação",
  "description": "Disputa e ciclo de vida dos holds (E4/E10): agregados, sem label por sessão (cardinalidade).",
  "tags": [
    "morfeu",
    "negocio"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Holds criados × recusados (por 5 min)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(reserva_holds_criados_total[5m]))",
          "legendFormat": "criados"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(reserva_holds_indisponiveis_total[5m]))",
          "legendFormat": "assento já travado"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Holds expirados × convertidos (por hora)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(reserva_holds_expirados_total[1h]))",
          "legendFormat": "expirados"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(reserva_holds_convertidos_total[1h]))",
          "legendFormat": "vendidos"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Taxa de disputa (recusados / tentativas, 15 min)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(reserva_holds_indisponiveis_total[15m])) / clamp_min(sum(increase(reserva_holds_criados_total[15m])) + sum(increase(reserva_holds_indisponiveis_total[15m])), 1)",
          "legendFormat": "disputa"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Conflitos de horário ao programar sessão (por dia)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(sessao_conflitos_total[24h]))",
          "legendFormat": "conflitos"
        }
      ]
    }
  ]
}
